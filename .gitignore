# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.venv/
venv/
.ipynb_checkpoints/

# Secrets & local env (never commit real values)
.env
.env.*
!.env.example
.streamlit/secrets.toml
secrets/
*.pem
*.key

# Docker / local volumes (course layout)
volumes/

# Data: keep folder structure via .gitkeep; never commit raw/confidential data.
# Course expects data/raw/; this repo also uses data/01_raw/ etc.
data/raw/
data/**
!data/**/
!data/**/.gitkeep
*.csv
*.xlsx
*.xls

# Model artifacts (regenerated by scripts/train.py)
models/*
!models/.gitkeep

# Research outputs / precomputed files (local only)
research/
precomputed/

# surgical_stopwords pipeline — ignore large/confidential interim artifacts
surgical_stopwords/data/raw/*
!surgical_stopwords/data/raw/.gitkeep
surgical_stopwords/data/interim/*
!surgical_stopwords/data/interim/.gitkeep
surgical_stopwords/data/processed/*
!surgical_stopwords/data/processed/.gitkeep
surgical_stopwords/.venv/

# macOS / editor
.DS_Store
~$*
