# Copy to .env and fill in local values. Never commit a real .env.
#   cp .env.example .env

# ── App ports ────────────────────────────────────────────────────────────────
# Streamlit dashboard (docker-compose service `app`)
STREAMLIT_PORT=8501

# FastAPI prediction service (docker-compose service `api`)
API_HOST=0.0.0.0
API_PORT=8000

# ── Paths ────────────────────────────────────────────────────────────────────
# Directory with trained artifacts (rf_model.pkl, tfidf.pkl, svd.pkl, …)
MODELS_DIR=models

# Raw surgical cases CSV (confidential — keep out of git)
DATA_RAW_PATH=data/01_raw/LoadFile.csv

# Inclusive ScheduledDate cutoff for ML train/test (later rows → monitoring)
ML_CUTOFF_DATE=2024-04-27

# ── Optional: API client (Streamlit or external callers) ─────────────────────
# Base URL used when calling the prediction API instead of in-process inference
API_BASE_URL=http://localhost:8000

# ── Optional: future monitoring / observability ──────────────────────────────
# MONITORING_DATA_START=2024-04-28
# LOG_LEVEL=INFO
