# Copy to .env and fill in local values. Never commit a real .env.
#   cp .env.example .env
#
# From your laptop → use localhost for POSTGRES_HOST / MINIO_HOST.
# From another container on surgery_network → use service names: postgres, minio.

# ── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_DB=surgery_ml
POSTGRES_USER=surgery
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ── MinIO (S3-compatible object storage) ─────────────────────────────────────
# Root user must be ≥3 chars; password ≥8 chars.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_me_minio_password
MINIO_HOST=localhost
MINIO_PORT=9000

# ── App (used later when FastAPI / Streamlit join Compose) ───────────────────
STREAMLIT_PORT=8501
API_HOST=0.0.0.0
API_PORT=8000
API_BASE_URL=http://localhost:8000
MODELS_DIR=models
DATA_RAW_PATH=data/01_raw/LoadFile.csv
ML_CUTOFF_DATE=2024-04-27
