# Copy to .env and fill in local values. Never commit a real .env.
#   cp .env.example .env
#
# From your laptop → use localhost for hosts.
# From another container on surgery_network → use service names: postgres, minio, mlflow.

# ── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_DB=surgery_ml
POSTGRES_USER=surgery
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ── MinIO (S3-compatible object storage) ─────────────────────────────────────
# Root user must be ≥3 chars; password ≥8 chars.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_me_minio_password
MINIO_HOST=localhost
MINIO_PORT=9000
MINIO_BUCKET=surgery-models

# ── MLflow ───────────────────────────────────────────────────────────────────
# Tracking UI / API (host). Inside Compose network use http://mlflow:5000
MLFLOW_PORT=5000
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_ARTIFACT_BUCKET=mlflow-artifacts
# boto3 talks to MinIO for artifact upload/download from your laptop
MLFLOW_S3_ENDPOINT_URL=http://localhost:9000
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=change_me_minio_password

# ── App (Streamlit / FastAPI) ────────────────────────────────────────────────
STREAMLIT_PORT=8501
API_HOST=0.0.0.0
API_PORT=8000
API_BASE_URL=http://localhost:8000
MODELS_DIR=models
DATA_RAW_PATH=data/01_raw/LoadFile.csv
ML_CUTOFF_DATE=2024-04-27
